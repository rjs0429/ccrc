#!/usr/bin/env bash
# Value for the VS Code setting claudeCode.claudeProcessWrapper; VS Code runs `ccrc-wrapper <claude> <args...>`.
# Conversation processes go through the relay so the broker can show and drive them. Everything else
# (config probes, `auth status`, worktree cleanup) and any launch without a usable Node runs claude directly.
stream=
prev=
for a in "$@"; do
  if [ "$a" = --input-format=stream-json ] || { [ "$prev" = --input-format ] && [ "$a" = stream-json ]; }; then
    stream=1
  fi
  prev=$a
done
if [ -z "$stream" ] || [ "${CLAUDE_CODE_CONFIG_PROBE:-}" = 1 ] || [ "${CCRC_WRAPPER:-}" = off ]; then
  exec "$@"
fi

DEFAULT_NODE=$HOME/.local/opt/node22/bin/node
NODE=${CCRC_NODE:-$DEFAULT_NODE}
[ -x "$NODE" ] || NODE=$(command -v node || true)
[ -n "$NODE" ] || exec "$@"

# The relay built by `npm run build` is used while it is newer than its sources; otherwise the sources
# run directly, which needs a Node that strips TypeScript.
SRC=$(dirname "$(readlink -f "$0")")/../broker/src
JS=$SRC/../dist/wrapper/main.js
if [ -f "$JS" ] && [ "$JS" -nt "$SRC/wrapper/main.ts" ] && [ "$JS" -nt "$SRC/wrapper/relay.ts" ] &&
  [ "$JS" -nt "$SRC/link/lines.ts" ] && [ "$JS" -nt "$SRC/link/protocol.ts" ]; then
  MAIN=$JS
  if [ "$NODE" != "$DEFAULT_NODE" ]; then
    "$NODE" -e 'process.exit(+process.versions.node.split(".")[0] >= 20 ? 0 : 1)' 2>/dev/null || exec "$@"
  fi
else
  MAIN=$SRC/wrapper/main.ts
  "$NODE" -e 'process.exit(process.features.typescript ? 0 : 1)' 2>/dev/null || exec "$@"
fi
exec "$NODE" --no-warnings "$MAIN" "$@"
