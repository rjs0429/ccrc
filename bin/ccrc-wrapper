#!/usr/bin/env bash
# Value for the VS Code setting claudeCode.claudeProcessWrapper; VS Code runs `ccrc-wrapper <claude> <args...>`.
# Conversation processes go through the relay so the broker can show and drive them. Everything else
# (config probes, `auth status`, worktree cleanup) and any launch without a usable Node runs claude directly.
stream=
prev=
for a in "$@"; do
  if [ "$a" = --input-format=stream-json ] || { [ "$prev" = --input-format ] && [ "$a" = stream-json ]; }; then
    stream=1
  fi
  prev=$a
done
if [ -z "$stream" ] || [ "${CLAUDE_CODE_CONFIG_PROBE:-}" = 1 ] || [ "${CCRC_WRAPPER:-}" = off ]; then
  exec "$@"
fi

# Node 22.18 or newer, looked for as bin/ccrc does; VS Code started from a desktop may have none on its PATH.
ROOT=$(dirname "$(readlink -f "$0")")/..
DATA=${CCRC_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ccrc}
INSTALLED=
[ -f "$ROOT/.ccrc-install.json" ] && INSTALLED=$(sed -n 's/.*"node"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/.ccrc-install.json" | head -n 1)
NODE=
for c in "${CCRC_NODE:-}" "$DATA/node/bin/node" "$INSTALLED" "$(command -v node || true)"; do
  if [ -n "$c" ] && [ -x "$c" ] && "$c" -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=18)?0:1)' 2>/dev/null; then
    NODE=$c
    break
  fi
done
if [ -z "$NODE" ]; then
  # Say why in the wrapper log, since VS Code shows nothing: the tab works, but the phone cannot see or drive it.
  STATE=${CCRC_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ccrc}
  LOG=${CCRC_WRAPPER_LOG:-$STATE/wrapper.log}
  (
    umask 077
    mkdir -p "$(dirname "$LOG")" &&
      printf '%s [%s] running claude directly: no Node.js 22.18 or newer (CCRC_NODE, %s, the install'"'"'s Node, PATH)\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" "$$" "$DATA/node/bin/node" >>"$LOG"
  ) 2>/dev/null || true
  exec "$@"
fi

# The relay built by `npm run build` is used while it is newer than its sources; otherwise the sources run directly.
SRC=$ROOT/broker/src
JS=$ROOT/broker/dist/wrapper/main.js
if [ -f "$JS" ] && [ -z "$(find "$SRC/wrapper" "$SRC/link" "$SRC/sessions/live.ts" "$SRC/paths.ts" "$SRC/dialogs.ts" -name '*.ts' -newer "$JS" 2>/dev/null | head -n 1)" ]; then
  MAIN=$JS
else
  MAIN=$SRC/wrapper/main.ts
fi
exec "$NODE" --no-warnings "$MAIN" "$@"
